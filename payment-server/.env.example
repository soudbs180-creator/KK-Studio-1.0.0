# ==============================
# KK-Studio 节点支付服务器配置库
# ==============================

PORT=8080

# 1. 前端域名（支付成功后回跳页面）
FRONTEND_URL=http://localhost:5173/

# 2. 回调网关域名 (支付宝必须能够访问这个地址进行异步通知)
# 如果本地测试，请使用 ngrok 或 natapp 等内网穿透工具，或保持空让本地失效
PAYMENT_NOTIFY_URL=http://your-domain.com/api/pay/notify/alipay

# 3. 支付宝核心凭证
ALIPAY_APP_ID=202100xxxxxxx你的APPID
ALIPAY_PRIVATE_KEY=MIIE... 你的应用私钥
ALIPAY_PUBLIC_KEY=MIIB... 你的截图上的“支付宝公钥”
ALIPAY_ENCRYPT_KEY=4vaXut... 你的截图上的 AES 加密串

# 4. VPS / 主 API / PostgreSQL
# 支付回调现在只会通过主 API 的内部结算接口回写积分，不再依赖旧云托管数据库。
KK_API_BASE_URL=http://127.0.0.1:3001
PAYMENT_SIDECAR_INTERNAL_TOKEN=replace-with-shared-internal-token
DATABASE_URL=postgres://kkstudio:CHANGE_ME@127.0.0.1:5432/kkstudio

# 5. [敬请期待] WeChat Pay 凭证
WECHATPAY_APPID=
WECHATPAY_MCHID=
WECHATPAY_API_V3_KEY=
WECHATPAY_SERIAL=
