# ==============================
# KK-Studio 节点支付服务器配置库
# ==============================

PORT=8080

# 1. 前端域名（支付成功后回跳页面）
FRONTEND_URL=http://localhost:5173/

# 2. 回调网关域名 (支付宝必须能够访问这个地址进行异步通知)
# 如果本地测试，请使用 ngrok 或 natapp 等内网穿透工具，或保持空让本地失效
PAYMENT_NOTIFY_URL=http://your-domain.com/api/pay/notify/alipay

# 3. 支付宝核心凭证
ALIPAY_APP_ID=202100xxxxxxx你的APPID
ALIPAY_PRIVATE_KEY=MIIE... 你的应用私钥
ALIPAY_PUBLIC_KEY=MIIB... 你的截图上的“支付宝公钥”
ALIPAY_ENCRYPT_KEY=4vaXut... 你的截图上的 AES 加密串

# 4. Supabase 对接（核心安全秘钥）
# 这就是前面你获取到的，只有这个秘钥能调用扣除费用的 RPC
# Legacy note: the payment webhook now writes settlements through the main API.
# SUPABASE_SERVICE_ROLE_KEY also enables durable payment_orders/payment_callbacks persistence.
# Without it, settlement still works, but runtime payment audit rows are skipped and exchange-rate lookup falls back to defaults.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4.1 Main API settlement bridge (required for callback write-back)
KK_API_BASE_URL=http://127.0.0.1:3001
PAYMENT_SIDECAR_INTERNAL_TOKEN=replace-with-shared-internal-token

# 4.2 Optional dynamic exchange-rate lookup
SUPABASE_URL=https://ovdjhdofjysanamgkfng.supabase.co
# If SUPABASE_SERVICE_ROLE_KEY is missing, the payment webhook falls back to the default rate map:
# CNY=5 credits, USD=30 credits.

# 5. [敬请期待] WeChat Pay 凭证
WECHATPAY_APPID=
WECHATPAY_MCHID=
WECHATPAY_API_V3_KEY=
WECHATPAY_SERIAL=
