# ============================================
# nano-banana-KK 环境变量配置模板
# 复制本文件为 .env，填入真实值
# ⚠️  .env 文件绝不能提交到 git
# ============================================

# -------- AI API Keys（仅后端使用，绝不暴露给前端）--------
GEMINI_API_KEY=              # Google AI Studio 获取：https://aistudio.google.com/apikey
OPENAI_API_KEY=              # OpenAI Platform 获取：https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4o-mini    # 可选，默认 gpt-4o-mini

# -------- 数据库（仅后端使用）--------
DATABASE_URL=                # PostgreSQL 连接字符串

# -------- 认证（仅后端使用）--------
JWT_SECRET=                  # 至少 32 位随机字符串

# -------- 支付（仅 payment-server / netlify 充值使用）--------
STRIPE_SECRET_KEY=           # Stripe Dashboard 获取
STRIPE_WEBHOOK_SECRET=       # Stripe Webhook 签名密钥

# -------- 内部服务通信（仅后端使用）--------
INTERNAL_API_TOKEN=          # Netlify Functions 调用 VPS 时用的内部 token
VPS_BASE_URL=                # VPS 服务器地址，例如：https://api.yourdomain.com

# -------- 前端公开配置（可以暴露，不含敏感信息）--------
VITE_PUBLIC_API_BASE_URL=/api           # 桌面端 API 基础路径
EXPO_PUBLIC_API_BASE_URL=https://your-site.netlify.app/api  # 手机端 API 基础路径
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key  # Cloudflare Turnstile 验证码 Site Key（开发测试可使用 1x00000000000000000000AA）
