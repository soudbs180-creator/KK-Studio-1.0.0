# KK Studio Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# Supabase Configuration (Required)
# ============================================
VITE_SUPABASE_URL=https://ovdjhdofjysanamgkfng.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_UvP5c6ShzuoYDtnZppd1yA_3L_m13l0

# Server-side Supabase admin credentials for apps/api
# SUPABASE_URL should normally match VITE_SUPABASE_URL
SUPABASE_URL=https://ovdjhdofjysanamgkfng.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local API skeleton runtime (optional for local development)
RUN_KK_API_SKELETON=true
PORT=3001

# ============================================
# Gemini / Unified API Key (Optional - can be set in UI)
# Get your key at: https://aistudio.google.com/apikey or your proxy platform
# ============================================
VITE_API_KEY=your-api-key-here

# ============================================
# Cloudflare Turnstile
# VITE_TURNSTILE_SITE_KEY is injected at build time, so changes require a redeploy.
# If this is omitted, the deployed login page will show a configuration warning
# instead of attempting to render an invalid widget.
# TURNSTILE_SECRET_KEY is only needed if you use server/turnstile_routes.ts.
# ============================================
VITE_TURNSTILE_ENABLED=true
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# ============================================
# Nutrient Document Processing (Optional, server-only)
# Never expose this through VITE_* variables.
# ============================================
NUTRIENT_API_KEY=your-nutrient-api-key
# NUTRIENT_DWS_API_KEY=your-nutrient-api-key

# ============================================
# WeChat Open Platform Login (Optional, server-only)
# The redirect URI must point to your API callback route, e.g.
# https://your-domain.com/api/v1/auth/wechat/callback
# Allowed redirect origins control where the browser is allowed to land after
# WeChat auth succeeds. Use a comma-separated origin list, e.g.
# https://app.example.com,https://admin.example.com
# Local development usually needs:
# http://localhost:5173,http://127.0.0.1:5173
# ============================================
WECHAT_OPEN_APP_ID=your-wechat-open-app-id
WECHAT_OPEN_APP_SECRET=your-wechat-open-app-secret
WECHAT_OPEN_REDIRECT_URI=https://your-domain.com/api/v1/auth/wechat/callback
WECHAT_STATE_SIGNING_SECRET=replace-with-a-long-random-secret
WECHAT_ALLOWED_REDIRECT_ORIGINS=https://your-domain.com

# ============================================
# For Vercel / Netlify deployment, set these in the project dashboard:
# - VITE_SUPABASE_URL
# - VITE_SUPABASE_ANON_KEY
# - SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# - VITE_API_KEY (optional, can also be configured in the UI)
# - VITE_TURNSTILE_ENABLED / VITE_TURNSTILE_SITE_KEY
# - VITE_PAYMENT_GATEWAY_URL (optional, if you use an external payment gateway)
# - TURNSTILE_SECRET_KEY (server-only, only if you use custom Turnstile verification routes)
# - NUTRIENT_API_KEY (server-only, for document conversion/OCR/extraction)
# - WECHAT_OPEN_APP_ID / WECHAT_OPEN_APP_SECRET / WECHAT_OPEN_REDIRECT_URI / WECHAT_STATE_SIGNING_SECRET / WECHAT_ALLOWED_REDIRECT_ORIGINS
# The app now has a built-in fallback for the public Supabase URL + anon key,
# but explicit deployment env vars are still recommended so every environment stays aligned.
# GEMINI_API_KEY=your-api-key
# ============================================
