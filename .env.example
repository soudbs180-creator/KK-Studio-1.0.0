# KK Studio Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# Supabase Configuration (Required)
# ============================================
VITE_SUPABASE_URL=https://ovdjhdofjysanamgkfng.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_UvP5c6ShzuoYDtnZppd1yA_3L_m13l0

# Server-side Supabase admin credentials for apps/api
# SUPABASE_URL should normally match VITE_SUPABASE_URL
SUPABASE_URL=https://ovdjhdofjysanamgkfng.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local API skeleton runtime (optional for local development)
RUN_KK_API_SKELETON=true
PORT=3001
# Legacy Web API base URL is local-only by default. Do not set VITE_KK_API_BASE_URL
# in Vercel unless you have deployed a compatible KK API endpoint on a real public URL.
# Hosted builds only enable this fallback when VITE_ENABLE_LEGACY_WEB_API_FALLBACK=true too.
# If you point it at localhost or a stale API, hosted builds can still be forced back onto legacy paths.
# VITE_KK_API_BASE_URL=https://your-public-kk-api.example.com
# VITE_ENABLE_LEGACY_WEB_API_FALLBACK=true

# ============================================
# Cloudflare Turnstile (optional override)
# The app falls back to the current shared kkai.plus site key when this is
# omitted, so local and deployed builds stay aligned by default.
# VITE_TURNSTILE_SITE_KEY is still injected at build time, so changes require a redeploy.
# TURNSTILE_SECRET_KEY is only needed if you use server/turnstile_routes.ts.
# ============================================
VITE_TURNSTILE_ENABLED=true
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# Canonical auth callback origin (optional but recommended for OAuth)
# Set this to your primary app origin so Google/Supabase callbacks do not
# bounce back to preview deployments or alternate hostnames.
# Example:
# VITE_AUTH_REDIRECT_ORIGIN=https://kkai.plus
VITE_AUTH_REDIRECT_ORIGIN=

# ============================================
# Nutrient Document Processing (Optional, server-only)
# Never expose this through VITE_* variables.
# ============================================
NUTRIENT_API_KEY=your-nutrient-api-key
# NUTRIENT_DWS_API_KEY=your-nutrient-api-key

# ============================================
# WeChat Open Platform Login (Optional, server-only)
# The redirect URI must point to the Supabase Edge Function callback, e.g.
# https://your-project.supabase.co/functions/v1/wechat-auth/callback
# Allowed redirect origins control where the browser is allowed to land after
# WeChat auth succeeds. Use a comma-separated origin list, e.g.
# https://app.example.com,https://admin.example.com
# Local development usually needs:
# http://localhost:5173,http://127.0.0.1:5173
# Production should keep WECHAT_ALLOWED_REDIRECT_ORIGINS non-empty.
# ============================================
WECHAT_OPEN_APP_ID=your-wechat-open-app-id
WECHAT_OPEN_APP_SECRET=your-wechat-open-app-secret
WECHAT_OPEN_REDIRECT_URI=https://your-project.supabase.co/functions/v1/wechat-auth/callback
WECHAT_STATE_SIGNING_SECRET=replace-with-a-long-random-secret
WECHAT_ALLOWED_REDIRECT_ORIGINS=https://your-domain.com
WECHAT_DEFAULT_REDIRECT_URL=https://your-domain.com/auth/callback

# ============================================
# For Vercel / Netlify deployment, set these in the project dashboard:
# - VITE_SUPABASE_URL
# - VITE_SUPABASE_ANON_KEY
# - VITE_TURNSTILE_ENABLED / VITE_TURNSTILE_SITE_KEY
# - VITE_AUTH_REDIRECT_ORIGIN (recommended for OAuth on custom/Vercel domains)
# - VITE_PAYMENT_GATEWAY_URL (optional, if you use an external payment gateway)
# Server-only vars below are for apps/api, payment-sidecar, or Supabase Edge Functions.
# A static Vercel frontend build does not use them at runtime:
# - SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# - TURNSTILE_SECRET_KEY (only if you run custom Turnstile verification routes)
# - NUTRIENT_API_KEY (document conversion/OCR/extraction)
# - WECHAT_OPEN_APP_ID / WECHAT_OPEN_APP_SECRET / WECHAT_OPEN_REDIRECT_URI / WECHAT_STATE_SIGNING_SECRET / WECHAT_ALLOWED_REDIRECT_ORIGINS
# The app now has a built-in fallback for the public Supabase URL + anon key,
# but explicit deployment env vars are still recommended so every environment stays aligned.
# Do not set VITE_KK_API_BASE_URL on Vercel unless you intentionally want the hosted app
# to call a separately deployed KK API. Leaving it unset keeps hosted builds on the Supabase path.
# Do not set VITE_ENABLE_LEGACY_WEB_API_FALLBACK on Vercel for the normal hosted release path.
# Never put third-party model provider secrets in VITE_* variables.
# Configure them through the authenticated server-side storage flow instead.
# ============================================
