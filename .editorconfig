root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
charset = utf-8
end_of_line = lf

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf
