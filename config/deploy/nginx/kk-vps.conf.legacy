# ==============================================================================
# [LEGACY / DEPRECATED]
# 该配置文件已废弃，不再作为当前 kk-studio 项目的 VPS 部署网关配置使用。
# 请勿将其软链接或复制到 /etc/nginx/sites-enabled/ 目录中。
# 当前唯一的生效网关配置为: config/deploy/nginx/kk-vps-gateway.conf
# ==============================================================================

server {
  listen 80;
  server_name app.example.com;

  root /srv/kk-studio/shared/www/app;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }
}

server {
  listen 80;
  server_name admin.example.com;

  root /srv/kk-studio/shared/www/admin;
  index index.html;

  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "same-origin" always;
  add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  location / {
    try_files $uri $uri/ /index.html;
  }
}

server {
  listen 80;
  server_name api.example.com;

  client_max_body_size 10m;

  location = /internal {
    return 404;
  }

  location /internal/ {
    return 404;
  }

  location /api/ {
    proxy_pass http://127.0.0.1:3001/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /healthz {
    proxy_pass http://127.0.0.1:3001/healthz;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
