SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional but recommended for parity with hosted secure-model-proxy:
# USER_API_ENCRYPTION_SECRET=replace-with-a-long-random-secret
# KK_INTERNAL_ROUTE_PROXY_SECRET=replace-with-a-long-random-secret
# SYSTEM_PROXY_TASK_SECRET=replace-with-a-long-random-secret
WECHAT_OPEN_APP_ID=your-wechat-open-app-id
WECHAT_OPEN_APP_SECRET=your-wechat-open-app-secret
WECHAT_OPEN_REDIRECT_URI=https://your-project.supabase.co/functions/v1/wechat-auth/callback
WECHAT_STATE_SIGNING_SECRET=replace-with-a-long-random-secret
WECHAT_ALLOWED_REDIRECT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.com
WECHAT_DEFAULT_REDIRECT_URL=https://your-domain.com/auth/callback
