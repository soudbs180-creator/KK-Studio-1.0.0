# KK Studio local backend environment template.
# Copy to server/.env.local for local backend development.
# Never commit server/.env or server/.env.local with real values.

RUN_KK_API_SKELETON=true
PORT=3001

GEMINI_API_KEY=CHANGE_ME_SERVER_ONLY
OPENAI_API_KEY=CHANGE_ME_SERVER_ONLY
OPENAI_CHAT_MODEL=gpt-4o-mini

DATABASE_URL=postgres://kkstudio:CHANGE_ME@127.0.0.1:5432/kkstudio
PASSWORD_SALT=CHANGE_ME_LONG_RANDOM_SECRET
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
KK_API_SESSION_SIGNING_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
USER_API_ENCRYPTION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
KKAI_LOCAL_ONLY=false

# Connection-backed image generation is server-gated and fails closed by default.
CAPABILITY_GRAPH_IMAGE_PROVIDER_SLICE=off
CAPABILITY_GRAPH_INTERNAL_USER_IDS=
CAPABILITY_GRAPH_INVITED_USER_IDS=

# Migration-only read path: available owner Connections win; legacy credentials remain the fallback.
PROVIDER_CONNECTION_LEGACY_DUAL_READ_ENABLED=false

# After migration 019, enable execution before admission.
# During rollback, turn admission off but leave execution on until leases drain.
GENERATION_IMAGE_WORKER_EXECUTION_ENABLED=false
GENERATION_IMAGE_DURABLE_WORKER_ENABLED=off
GENERATION_IMAGE_WORKER_INTERNAL_USER_IDS=
GENERATION_IMAGE_WORKER_INVITED_USER_IDS=
GENERATION_IMAGE_WORKER_LEASE_MS=30000
GENERATION_IMAGE_WORKER_HEARTBEAT_MS=10000
GENERATION_IMAGE_WORKER_OPERATION_TIMEOUT_MS=60000
GENERATION_IMAGE_WORKER_JOB_TIMEOUT_MS=900000
GENERATION_IMAGE_WORKER_POLL_INTERVAL_MS=1000
GENERATION_IMAGE_WORKER_MAX_POLL_INTERVAL_MS=30000
GENERATION_IMAGE_WORKER_MAX_ATTEMPTS=3

PUBLIC_APP_URL=http://127.0.0.1:5173
PASSWORD_RESET_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
PASSWORD_RESET_EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=CHANGE_ME_SERVER_ONLY

# Google / WeChat OAuth secrets stay server-side. Provider consoles must use these exact callback URLs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/api/v1/auth/google/callback
GOOGLE_ALLOWED_REDIRECT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=http://127.0.0.1:3001/api/v1/auth/wechat/callback
WECHAT_ALLOWED_REDIRECT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OAUTH_STATE_TTL_SECONDS=600

STRIPE_SECRET_KEY=CHANGE_ME_SERVER_ONLY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_SERVER_ONLY

ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
KK_API_MAX_JSON_BODY_BYTES=10485760
KK_API_PROFILE_MAX_JSON_BODY_BYTES=1048576
KK_API_KEY_MANAGER_MAX_JSON_BODY_BYTES=1048576
