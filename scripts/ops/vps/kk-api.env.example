NODE_ENV=production
KKAI_LOCAL_ONLY=false
RUN_KK_API_SKELETON=true
PORT=3001
GEMINI_API_KEY=CHANGE_ME_SERVER_ONLY
VODESHOP_RELAY_API_KEY=CHANGE_ME_SERVER_ONLY
OPENAI_API_KEY=CHANGE_ME_SERVER_ONLY
DATABASE_URL=postgres://kkstudio:CHANGE_ME@127.0.0.1:5432/kkstudio
PASSWORD_SALT=CHANGE_ME_LONG_RANDOM_SECRET
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
KK_API_SESSION_SIGNING_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
KK_SESSION_COOKIE_SECURE=true
KK_SESSION_COOKIE_SAME_SITE=none
USER_API_ENCRYPTION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
PUBLIC_APP_URL=https://app.example.com
PASSWORD_RESET_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
PASSWORD_RESET_EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=CHANGE_ME_SERVER_ONLY
KK_AUTH_REQUIRE_TURNSTILE=true
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
KK_PRIMARY_ADMIN_USER_ID=admin-user-1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback
GOOGLE_ALLOWED_REDIRECT_ORIGINS=https://app.example.com,https://admin.example.com
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=https://api.example.com/api/v1/auth/wechat/callback
WECHAT_ALLOWED_REDIRECT_ORIGINS=https://app.example.com,https://admin.example.com
OAUTH_STATE_TTL_SECONDS=600
STRIPE_SECRET_KEY=CHANGE_ME_SERVER_ONLY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_SERVER_ONLY
