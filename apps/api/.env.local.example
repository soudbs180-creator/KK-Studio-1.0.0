# Server-only Supabase runtime config for local API development.
# Copy this file to apps/api/.env.local and fill in the real service role key.
# Root .env/.env.local are for frontend/public runtime values and do not act as the
# authoritative local API source for these server-only keys.
# Legacy server/.env files are ignored by run-api-dev and diagnostics.
# scripts/run-api-dev.mjs only reads root .env/.env.local and apps/api/.env(.local).
# Legacy server/.env files are ignored for the local API startup path.

SUPABASE_URL=https://ovdjhdofjysanamgkfng.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
USER_API_ENCRYPTION_SECRET=replace-with-a-stable-random-secret
KK_PRIMARY_ADMIN_USER_ID=replace-with-the-owner-supabase-user-id

# Optional body-size overrides for local API JSON uploads.
# Defaults when unset:
# - KK_API_MAX_JSON_BODY_BYTES=1048576 (1 MB) for standard routes
# - KK_API_PROFILE_MAX_JSON_BODY_BYTES=4194304 (4 MB) for
#   /api/v1/profile/user-apis, /api/v1/profile/user-apis/payload,
#   and /api/v1/profile/key-manager-state
# Use KK_API_KEY_MANAGER_MAX_JSON_BODY_BYTES if you only want to override the
# legacy key-manager bridge limit and keep the broader profile routes unchanged.
# KK_API_MAX_JSON_BODY_BYTES=1048576
# KK_API_PROFILE_MAX_JSON_BODY_BYTES=4194304
# KK_API_KEY_MANAGER_MAX_JSON_BODY_BYTES=4194304

# Optional server-only integrations
# WECHAT_OPEN_APP_ID=
# WECHAT_OPEN_APP_SECRET=
# WECHAT_OPEN_REDIRECT_URI=
# WECHAT_STATE_SIGNING_SECRET=
# WECHAT_ALLOWED_REDIRECT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# After updating this file, run:
# npm run api:diagnose
# npm run release:hosted:check
