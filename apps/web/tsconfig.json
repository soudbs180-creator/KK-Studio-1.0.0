{
	"include": [
		"**/*.{ts,tsx,js,jsx}",
		"**/.server/**/*",
		"**/.client/**/*",
		".react-router/types/**/*",
		"./src/global.d.ts"
	],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node", "vite/client"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"baseUrl": ".",
		"ignoreDeprecations": "5.0",
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"paths": {
			"@/*": ["./src/*"],
			"@nano-banana/api-client": ["../../packages/api-client/src/index.ts"]
		}
	},
	"exclude": [
		"node_modules",
		"**/__create/**/*",
		"**/__create",
		"src/app/api/vitest.config.ts"
	]
}
