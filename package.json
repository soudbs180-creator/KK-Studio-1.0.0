{
    "name": "kk-studio",
    "private": true,
    "version": "1.4.0",
    "type": "module",
    "packageManager": "npm@11.6.2",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
    "dev": "vite",
    "dev:start": "powershell -ExecutionPolicy Bypass -File scripts/dev-launch.ps1",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/dev-stop.ps1",
    "dev:status": "powershell -ExecutionPolicy Bypass -File scripts/dev-status.ps1",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "api:dev": "node --watch scripts/run-api-dev.mjs",
    "api:start": "node scripts/run-api-dev.mjs",
    "api:diagnose": "node scripts/diagnose-api-env.mjs",
    "release:hosted:check": "node scripts/diagnose-hosted-release.mjs",
    "release:hosted": "node scripts/release-hosted.mjs",
    "release:hosted:preview": "node scripts/release-hosted.mjs --preview",
    "build": "vite build",
    "organize:local": "node scripts/maintenance/organize-local-files.mjs",
    "package:portable": "npm run build && node scripts/create-portable-release.mjs",
    "package:portable:with-payment-env": "npm run build && node scripts/create-portable-release.mjs --include-payment-env",
    "publish:portable": "node scripts/release/publish-portable-release.mjs",
    "package:portable:publish": "npm run package:portable && npm run publish:portable",
        "spec:check": "node scripts/architecture/check-spec-structure.mjs && npx swagger-cli validate docs/specs/openapi.yaml",
        "architecture:check": "node scripts/architecture/check-import-boundaries.mjs && node scripts/architecture/check-frontend-supabase-boundaries.mjs && node scripts/architecture/check-legacy-zone-boundaries.mjs",
        "governance:version": "node scripts/governance/check-version-consistency.mjs",
        "governance:agent-docs": "node scripts/governance/check-agent-docs.mjs",
        "governance:compat": "node scripts/governance/check-compatibility-registry.mjs",
        "governance:security": "node scripts/governance/check-sensitive-boundaries.mjs",
        "governance:check": "npm run governance:version && npm run governance:agent-docs && npm run governance:compat && npm run governance:security",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.architecture.json",
        "test:unit": "node --test \"tests/unit/*.test.ts\"",
        "test:contract": "node --test \"tests/contract/*.test.ts\"",
        "test:e2e": "node --test \"tests/e2e/*.test.ts\"",
        "test": "npm run test:unit && npm run test:contract && npm run test:e2e",
    "supabase:audit": "node scripts/audit-supabase.mjs",
    "supabase:functions:serve:user-route-proxy": "npx supabase functions serve user-route-proxy --env-file supabase/.env.functions.local",
    "supabase:functions:deploy:user-route-proxy": "npx supabase functions deploy user-route-proxy",
    "supabase:functions:serve:admin-credit-models": "npx supabase functions serve admin-credit-models --env-file supabase/.env.functions.local",
    "supabase:functions:deploy:admin-credit-models": "npx supabase functions deploy admin-credit-models --no-verify-jwt",
    "supabase:functions:deploy:secure-model-proxy": "npx supabase functions deploy secure-model-proxy",
    "supabase:functions:deploy:wechat-auth": "npx supabase functions deploy wechat-auth --no-verify-jwt",
        "verify:changes": "npm run architecture:check && npm run governance:check && npm run typecheck && npm run spec:check && npm run supabase:audit",
        "preview": "vite preview",
        "clean": "node -e \"try{require('fs').rmSync('node_modules/.vite',{recursive:true})}catch(e){}\"",
        "check:encoding": "node scripts/check-encoding.js"
    },
    "dependencies": {
        "@google/genai": "^1.35.0",
        "@supabase/supabase-js": "^2.90.1",
        "@types/file-saver": "^2.0.7",
        "antd": "^6.1.1",
        "canvas-confetti": "^1.9.4",
        "class-variance-authority": "^0.7.1",
        "es-toolkit": "^1.44.0",
        "file-saver": "^2.0.5",
        "framer-motion": "^12.34.4",
        "gsap": "^3.14.2",
        "jszip": "^3.10.1",
        "lucide-react": "^0.562.0",
        "motion": "^12.0.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-dropzone": "^15.0.0",
        "react-router-dom": "^6.22.0",
        "tar": "7.5.11",
        "three": "^0.183.2",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@netlify/functions": "^3.0.0",
        "@tailwindcss/postcss": "^4.0.0",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^22.14.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/three": "^0.183.1",
        "@vitejs/plugin-react": "^5.0.0",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.5.0",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.0"
    },
    "overrides": {
        "brace-expansion": "5.0.5",
        "cosmiconfig": {
            "yaml": "1.10.3"
        },
        "lodash": "4.18.1",
        "lodash-es": "4.18.1",
        "micromatch": {
            "picomatch": "2.3.2"
        },
        "tar": "7.5.11",
        "minimatch": "9.0.7",
        "picomatch": "4.0.4",
        "qs": "6.15.0",
        "rollup": "4.60.1"
    }
}
