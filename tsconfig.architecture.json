{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "module": "ESNext",
        "moduleResolution": "node",
        "allowImportingTsExtensions": true,
        "types": [
            "node",
            "vite/client"
        ],
        "strict": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": false,
        "noEmit": true
    },
    "include": [
        "src/**/*.d.ts",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "packages/**/*.ts"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}
