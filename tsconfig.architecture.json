{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "types": [
            "node",
            "vite/client"
        ],
        "strict": true,
        "noImplicitAny": false,
        "ignoreDeprecations": "6.0",
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@/*": ["./apps/web/src/*"],
            "@kk/shared": ["./packages/shared/src/index.ts"],
            "@kk/ui": ["./packages/ui/src/index.ts"],
            "@nano-banana/api-client": ["./packages/api-client/src/index.ts"]
        },
        "noEmit": true
    },
    "include": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "packages/**/*.ts"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "apps/mobile",
        "apps/web/__create",
        "apps/web/src/__create",
        "apps/web/plugins",
        "apps/web/vite.config.ts",
        "**/__create/**/*",
        "**/__create"
    ]
}
