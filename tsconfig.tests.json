{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "types": [
            "node",
            "vite/client"
        ],
        "jsx": "react-jsx",
        "strict": false,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@/*": ["./apps/web/src/*"],
            "@kk/shared": ["./packages/shared/src/index.ts"],
            "@kk/ui": ["./packages/ui/src/index.ts"],
            "@nano-banana/api-client": ["./packages/api-client/src/index.ts"]
        },
        "noEmit": true
    },
    "include": [
        "tests/contract/**/*.ts",
        "tests/integration/**/*.ts",
        "tests/unit/**/*.ts"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "tests/e2e/**/*.ts"
    ]
}
